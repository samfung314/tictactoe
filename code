<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tic Tac Toe Deluxe</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tone.js for Web Audio sound effects -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Outfit', sans-serif;
            user-select: none;
            -webkit-user-select: none;
        }

        /* Neon / Glow Theme Custom Styles */
        .glow-x {
            text-shadow: 0 0 15px rgba(239, 68, 68, 0.7), 0 0 30px rgba(239, 68, 68, 0.4);
        }
        .glow-o {
            text-shadow: 0 0 15px rgba(59, 130, 246, 0.7), 0 0 30px rgba(59, 130, 246, 0.4);
        }
        .box-glow {
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }

        /* Animations */
        @keyframes popIn {
            0% { transform: scale(0) rotate(-180deg); opacity: 0; }
            70% { transform: scale(1.2) rotate(10deg); opacity: 1; }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }
        .animate-pop {
            animation: popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes winPulse {
            0%, 100% { transform: scale(1); filter: brightness(1); }
            50% { transform: scale(1.08); filter: brightness(1.3); }
        }
        .animate-win {
            animation: winPulse 1s infinite ease-in-out;
        }

        /* Custom scrollbar for game logs if needed */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.2);
            border-radius: 3px;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between items-center p-4 sm:p-6 overflow-x-hidden">

    <!-- Header Section -->
    <header class="w-full max-w-md flex justify-between items-center mb-2">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-shapes text-indigo-500 text-2xl sm:text-3xl"></i>
            <h1 class="text-2xl sm:text-3xl font-black tracking-wider bg-clip-text text-transparent bg-gradient-to-r from-rose-500 via-purple-500 to-indigo-400">
                TIC TAC TOE
            </h1>
        </div>
        <button id="soundToggle" class="p-3 bg-slate-900 border border-slate-800 rounded-xl hover:bg-slate-800 transition text-slate-300 hover:text-white" title="Toggle Sound">
            <i id="soundIcon" class="fa-solid fa-volume-high text-lg"></i>
        </button>
    </header>

    <!-- Main Container -->
    <main class="w-full max-w-md flex flex-col items-center gap-4 my-auto">

        <!-- Mode & Difficulty Selectors -->
        <div class="w-full grid grid-cols-2 gap-2 bg-slate-900/80 p-1.5 rounded-2xl border border-slate-800 backdrop-blur">
            <button id="modePvP" class="mode-btn py-2 px-3 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 bg-indigo-600 text-white shadow-lg">
                <i class="fa-solid fa-users text-xs"></i> 2 Players
            </button>
            <button id="modeAI" class="mode-btn py-2 px-3 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 text-slate-400 hover:text-white">
                <i class="fa-solid fa-robot text-xs"></i> vs AI
            </button>
        </div>

        <!-- AI Difficulty Options (Hidden by default) -->
        <div id="aiDifficultyContainer" class="w-full hidden flex-col gap-1.5 transition-all duration-300">
            <div class="flex justify-between items-center px-1">
                <span class="text-xs text-slate-400 uppercase tracking-wider font-bold">AI Difficulty</span>
                <span id="aiSymbolText" class="text-xs text-indigo-400 font-semibold">AI plays as O</span>
            </div>
            <div class="grid grid-cols-3 gap-2 bg-slate-900/40 p-1 rounded-xl border border-slate-800/80">
                <button data-diff="easy" class="diff-btn py-1.5 px-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">Easy</button>
                <button data-diff="medium" class="diff-btn py-1.5 px-2 rounded-lg text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 transition">Medium</button>
                <button data-diff="hard" class="diff-btn py-1.5 px-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">Unbeatable</button>
            </div>
        </div>

        <!-- Score Board -->
        <div class="w-full grid grid-cols-3 gap-3 bg-slate-900 border border-slate-800 p-3 rounded-2xl text-center box-glow">
            <div class="flex flex-col items-center bg-slate-950/60 p-2 rounded-xl border border-rose-500/20">
                <span class="text-xs font-bold text-rose-400 uppercase tracking-wider flex items-center gap-1">
                    <i class="fa-solid fa-xmark"></i> Player X
                </span>
                <span id="scoreX" class="text-2xl font-black text-rose-500">0</span>
            </div>
            <div class="flex flex-col items-center bg-slate-950/60 p-2 rounded-xl border border-slate-700/30">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Ties</span>
                <span id="scoreTies" class="text-2xl font-black text-slate-300">0</span>
            </div>
            <div class="flex flex-col items-center bg-slate-950/60 p-2 rounded-xl border border-blue-500/20">
                <span id="playerOText" class="text-xs font-bold text-blue-400 uppercase tracking-wider flex items-center gap-1">
                    <i class="fa-regular fa-circle"></i> Player O
                </span>
                <span id="scoreO" class="text-2xl font-black text-blue-500">0</span>
            </div>
        </div>

        <!-- Status Indicator -->
        <div id="statusBadge" class="w-full py-2.5 px-4 bg-slate-900 border border-slate-800 rounded-xl flex items-center justify-center gap-2 text-sm font-semibold transition-all">
            <span>Turn: </span>
            <span id="turnDisplay" class="text-rose-500 font-bold flex items-center gap-1">
                <i class="fa-solid fa-xmark"></i> Player X
            </span>
        </div>

        <!-- Game Board Canvas Container -->
        <div class="relative w-full aspect-square bg-slate-900/90 border border-slate-800 rounded-3xl p-3 box-glow backdrop-blur shadow-2xl flex items-center justify-center">
            
            <!-- 3x3 Grid -->
            <div id="board" class="w-full h-full grid grid-cols-3 grid-rows-3 gap-3">
                <!-- Cell 0 -->
                <button data-index="0" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
                <!-- Cell 1 -->
                <button data-index="1" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
                <!-- Cell 2 -->
                <button data-index="2" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
                <!-- Cell 3 -->
                <button data-index="3" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
                <!-- Cell 4 -->
                <button data-index="4" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
                <!-- Cell 5 -->
                <button data-index="5" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
                <!-- Cell 6 -->
                <button data-index="6" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
                <!-- Cell 7 -->
                <button data-index="7" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
                <!-- Cell 8 -->
                <button data-index="8" class="cell bg-slate-950/80 hover:bg-slate-800/60 active:scale-95 transition-all rounded-2xl flex items-center justify-center text-5xl sm:text-6xl font-black border border-slate-800/80 outline-none"></button>
            </div>
        </div>

        <!-- Controls / Actions -->
        <div class="w-full grid grid-cols-2 gap-3 mt-1">
            <button id="resetRoundBtn" class="py-3 px-4 bg-slate-900 border border-slate-800 rounded-xl hover:bg-slate-800 text-slate-300 hover:text-white font-semibold text-sm transition flex items-center justify-center gap-2 active:scale-95">
                <i class="fa-solid fa-rotate-right"></i> Reset Board
            </button>
            <button id="resetScoreBtn" class="py-3 px-4 bg-slate-900 border border-slate-800 rounded-xl hover:bg-slate-800 text-rose-400/80 hover:text-rose-400 font-semibold text-sm transition flex items-center justify-center gap-2 active:scale-95">
                <i class="fa-solid fa-trash-can"></i> Reset Scores
            </button>
        </div>

    </main>

    <!-- Footer -->
    <footer class="text-xs text-slate-600 mt-4 text-center">
        Classic Game • Crafted with HTML, Tailwind & JS
    </footer>

    <!-- Result Modal Overlay -->
    <div id="resultModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 z-50 opacity-0 pointer-events-none transition-all duration-300">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-xs w-full text-center flex flex-col items-center gap-4 shadow-2xl transform scale-90 transition-all duration-300" id="modalCard">
            <div id="modalIcon" class="w-20 h-20 rounded-full bg-slate-800 flex items-center justify-center text-4xl mb-1">
                🏆
            </div>
            <div class="flex flex-col gap-1">
                <h2 id="modalTitle" class="text-2xl font-black tracking-wide">PLAYER X WINS!</h2>
                <p id="modalSub" class="text-xs text-slate-400">Great move! Another round?</p>
            </div>
            <button id="modalPlayAgain" class="w-full py-3 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/30 transition active:scale-95 mt-2">
                Play Next Round
            </button>
        </div>
    </div>

    <!-- JavaScript Game Logic -->
    <script>
        // --- GAME STATE ---
        let boardState = ['', '', '', '', '', '', '', '', ''];
        let currentPlayer = 'X';
        let gameActive = true;
        let gameMode = 'pvp'; // 'pvp' or 'ai'
        let aiDifficulty = 'medium'; // 'easy', 'medium', 'hard'
        let soundEnabled = true;
        let scores = { X: 0, O: 0, ties: 0 };

        // Winning Combinations
        const WINNING_COMBOS = [
            [0, 1, 2], [3, 4, 5], [6, 7, 8], // Rows
            [0, 3, 6], [1, 4, 7], [2, 5, 8], // Columns
            [0, 4, 8], [2, 4, 6]             // Diagonals
        ];

        // --- DOM ELEMENTS ---
        const cells = document.querySelectorAll('.cell');
        const statusDisplay = document.getElementById('turnDisplay');
        const modePvPBtn = document.getElementById('modePvP');
        const modeAIBtn = document.getElementById('modeAI');
        const aiDifficultyContainer = document.getElementById('aiDifficultyContainer');
        const diffBtns = document.querySelectorAll('.diff-btn');
        const playerOText = document.getElementById('playerOText');
        const scoreXEl = document.getElementById('scoreX');
        const scoreOEl = document.getElementById('scoreO');
        const scoreTiesEl = document.getElementById('scoreTies');
        const resetRoundBtn = document.getElementById('resetRoundBtn');
        const resetScoreBtn = document.getElementById('resetScoreBtn');
        const soundToggleBtn = document.getElementById('soundToggle');
        const soundIcon = document.getElementById('soundIcon');
        
        // Modal DOM Elements
        const resultModal = document.getElementById('resultModal');
        const modalCard = document.getElementById('modalCard');
        const modalTitle = document.getElementById('modalTitle');
        const modalSub = document.getElementById('modalSub');
        const modalIcon = document.getElementById('modalIcon');
        const modalPlayAgain = document.getElementById('modalPlayAgain');

        // --- AUDIO SYNTHESIS (Tone.js) ---
        let synth, polySynth;
        
        function initAudio() {
            if (!synth) {
                synth = new Tone.Synth({
                    oscillator: { type: 'sine' },
                    envelope: { attack: 0.005, decay: 0.1, sustain: 0, release: 0.1 }
                }).toDestination();
                
                polySynth = new Tone.PolySynth(Tone.Synth).toDestination();
                polySynth.set({
                    envelope: { attack: 0.01, decay: 0.2, sustain: 0.1, release: 0.3 }
                });
            }
        }

        function playSound(type) {
            if (!soundEnabled) return;
            try {
                initAudio();
                Tone.start();
                if (type === 'X') {
                    synth.triggerAttackRelease('C5', '16n');
                } else if (type === 'O') {
                    synth.triggerAttackRelease('G4', '16n');
                } else if (type === 'win') {
                    const now = Tone.now();
                    polySynth.triggerAttackRelease(['C4', 'E4', 'G4', 'C5'], '8n', now);
                } else if (type === 'tie') {
                    const now = Tone.now();
                    polySynth.triggerAttackRelease(['A3', 'G#3', 'G3'], '16n', now);
                } else if (type === 'click') {
                    synth.triggerAttackRelease('E5', '32n');
                }
            } catch (e) {
                console.log('Audio playback prevented or unsupported');
            }
        }

        // --- GAME LOGIC ---

        function handleCellClick(e) {
            const cell = e.target;
            const index = parseInt(cell.getAttribute('data-index'));

            // Ignore if cell occupied, game inactive, or waiting for AI turn
            if (boardState[index] !== '' || !gameActive) return;
            if (gameMode === 'ai' && currentPlayer === 'O') return;

            makeMove(index, currentPlayer);

            // AI Move logic
            if (gameActive && gameMode === 'ai' && currentPlayer === 'O') {
                setTimeout(triggerAIMove, 400);
            }
        }

        function makeMove(index, player) {
            boardState[index] = player;
            const cell = cells[index];
            
            // Render Cell content with animations & styling
            if (player === 'X') {
                cell.innerHTML = `<span class="glow-x text-rose-500 animate-pop flex items-center justify-center"><i class="fa-solid fa-xmark"></i></span>`;
                playSound('X');
            } else {
                cell.innerHTML = `<span class="glow-o text-blue-500 animate-pop flex items-center justify-center"><i class="fa-regular fa-circle"></i></span>`;
                playSound('O');
            }

            // Check Win or Tie
            const winCombo = checkWin(boardState, player);
            if (winCombo) {
                gameActive = false;
                highlightWinningCells(winCombo);
                scores[player]++;
                updateScoreboard();
                playSound('win');
                setTimeout(() => showResultModal(`${player === 'X' ? 'Player X' : (gameMode === 'ai' ? 'AI' : 'Player O')} Wins!`, player), 600);
                return;
            }

            if (checkTie(boardState)) {
                gameActive = false;
                scores.ties++;
                updateScoreboard();
                playSound('tie');
                setTimeout(() => showResultModal("It's a Tie!", 'tie'), 500);
                return;
            }

            // Switch turn
            currentPlayer = currentPlayer === 'X' ? 'O' : 'X';
            updateTurnDisplay();
        }

        function checkWin(board, player) {
            for (let combo of WINNING_COMBOS) {
                if (board[combo[0]] === player && board[combo[1]] === player && board[combo[2]] === player) {
                    return combo;
                }
            }
            return null;
        }

        function checkTie(board) {
            return board.every(cell => cell !== '');
        }

        function highlightWinningCells(combo) {
            combo.forEach(idx => {
                cells[idx].classList.add('animate-win', 'bg-slate-800');
            });
        }

        function updateTurnDisplay() {
            if (currentPlayer === 'X') {
                statusDisplay.innerHTML = `<span class="text-rose-500 font-bold flex items-center gap-1"><i class="fa-solid fa-xmark"></i> Player X</span>`;
            } else {
                const name = gameMode === 'ai' ? 'AI Bot' : 'Player O';
                statusDisplay.innerHTML = `<span class="text-blue-500 font-bold flex items-center gap-1"><i class="fa-regular fa-circle"></i> ${name}</span>`;
            }
        }

        function updateScoreboard() {
            scoreXEl.textContent = scores.X;
            scoreOEl.textContent = scores.O;
            scoreTiesEl.textContent = scores.ties;
        }

        // --- AI BOT LOGIC ---

        function triggerAIMove() {
            if (!gameActive) return;

            let bestIndex;
            const availableIndices = boardState.map((val, idx) => val === '' ? idx : null).filter(val => val !== null);

            if (aiDifficulty === 'easy') {
                // Random move
                bestIndex = availableIndices[Math.floor(Math.random() * availableIndices.length)];
            } else if (aiDifficulty === 'medium') {
                // 50% Minimax, 50% Random
                if (Math.random() > 0.5) {
                    bestIndex = getBestMoveMinimax().index;
                } else {
                    bestIndex = availableIndices[Math.floor(Math.random() * availableIndices.length)];
                }
            } else {
                // Unbeatable Minimax
                bestIndex = getBestMoveMinimax().index;
            }

            if (bestIndex !== undefined && bestIndex !== null) {
                makeMove(bestIndex, 'O');
            }
        }

        // Minimax Algorithm implementation
        function getBestMoveMinimax() {
            return minimax(boardState, 'O');
        }

        function minimax(newBoard, player) {
            const availSpots = newBoard.map((val, idx) => val === '' ? idx : null).filter(val => val !== null);

            if (checkWin(newBoard, 'X')) {
                return { score: -10 };
            } else if (checkWin(newBoard, 'O')) {
                return { score: 10 };
            } else if (availSpots.length === 0) {
                return { score: 0 };
            }

            const moves = [];

            for (let i = 0; i < availSpots.length; i++) {
                const move = {};
                move.index = availSpots[i];
                newBoard[availSpots[i]] = player;

                if (player === 'O') {
                    const result = minimax(newBoard, 'X');
                    move.score = result.score;
                } else {
                    const result = minimax(newBoard, 'O');
                    move.score = result.score;
                }

                newBoard[availSpots[i]] = '';
                moves.push(move);
            }

            let bestMove;
            if (player === 'O') {
                let bestScore = -10000;
                for (let i = 0; i < moves.length; i++) {
                    if (moves[i].score > bestScore) {
                        bestScore = moves[i].score;
                        bestMove = i;
                    }
                }
            } else {
                let bestScore = 10000;
                for (let i = 0; i < moves.length; i++) {
                    if (moves[i].score < bestScore) {
                        bestScore = moves[i].score;
                        bestMove = i;
                    }
                }
            }

            return moves[bestMove];
        }

        // --- MODAL & UI CONTROLS ---

        function showResultModal(message, winner) {
            modalTitle.textContent = message.toUpperCase();
            
            if (winner === 'X') {
                modalIcon.innerHTML = `<i class="fa-solid fa-trophy text-amber-400"></i>`;
                modalSub.textContent = "Player X dominated the board!";
            } else if (winner === 'O') {
                modalIcon.innerHTML = gameMode === 'ai' 
                    ? `<i class="fa-solid fa-robot text-blue-400"></i>` 
                    : `<i class="fa-solid fa-trophy text-amber-400"></i>`;
                modalSub.textContent = gameMode === 'ai' ? "The AI calculated victory." : "Player O took the crown!";
            } else {
                modalIcon.innerHTML = `<i class="fa-solid fa-handshake text-slate-400"></i>`;
                modalSub.textContent = "An evenly matched battle!";
            }

            resultModal.classList.remove('opacity-0', 'pointer-events-none');
            modalCard.classList.remove('scale-90');
            modalCard.classList.add('scale-100');
        }

        function hideResultModal() {
            resultModal.classList.add('opacity-0', 'pointer-events-none');
            modalCard.classList.remove('scale-100');
            modalCard.classList.add('scale-90');
        }

        function resetRound() {
            boardState = ['', '', '', '', '', '', '', '', ''];
            currentPlayer = 'X';
            gameActive = true;
            
            cells.forEach(cell => {
                cell.innerHTML = '';
                cell.classList.remove('animate-win', 'bg-slate-800');
            });

            updateTurnDisplay();
            hideResultModal();
            playSound('click');
        }

        function resetScores() {
            scores = { X: 0, O: 0, ties: 0 };
            updateScoreboard();
            resetRound();
        }

        // --- EVENT LISTENERS ---

        cells.forEach(cell => cell.addEventListener('click', handleCellClick));

        resetRoundBtn.addEventListener('click', resetRound);
        resetScoreBtn.addEventListener('click', resetScores);
        modalPlayAgain.addEventListener('click', resetRound);

        // Mode Switching
        modePvPBtn.addEventListener('click', () => {
            if (gameMode === 'pvp') return;
            gameMode = 'pvp';
            modePvPBtn.className = "mode-btn py-2 px-3 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 bg-indigo-600 text-white shadow-lg";
            modeAIBtn.className = "mode-btn py-2 px-3 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 text-slate-400 hover:text-white";
            aiDifficultyContainer.classList.add('hidden');
            playerOText.innerHTML = `<i class="fa-regular fa-circle"></i> Player O`;
            resetScores();
        });

        modeAIBtn.addEventListener('click', () => {
            if (gameMode === 'ai') return;
            gameMode = 'ai';
            modeAIBtn.className = "mode-btn py-2 px-3 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 bg-indigo-600 text-white shadow-lg";
            modePvPBtn.className = "mode-btn py-2 px-3 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 text-slate-400 hover:text-white";
            aiDifficultyContainer.classList.remove('hidden');
            playerOText.innerHTML = `<i class="fa-solid fa-robot"></i> AI Bot`;
            resetScores();
        });

        // AI Difficulty Selection
        diffBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                diffBtns.forEach(b => b.className = "diff-btn py-1.5 px-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition");
                e.target.className = "diff-btn py-1.5 px-2 rounded-lg text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 transition";
                aiDifficulty = e.target.getAttribute('data-diff');
                resetRound();
            });
        });

        // Sound Toggle
        soundToggleBtn.addEventListener('click', () => {
            soundEnabled = !soundEnabled;
            if (soundEnabled) {
                soundIcon.className = "fa-solid fa-volume-high text-lg text-slate-300";
            } else {
                soundIcon.className = "fa-solid fa-volume-xmark text-lg text-rose-400";
            }
        });

        // Initialize state on window load
        window.onload = () => {
            updateTurnDisplay();
            updateScoreboard();
        };
    </script>
</body>
</html>
